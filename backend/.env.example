# Django Core Settings
# IMPORTANT: Generate a new secret key for production.
# You can use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
# Include .ngrok-free.app while testing webhooks through an ngrok tunnel
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev,.ngrok.app,.ngrok.io
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Settings (PostgreSQL)
# These are used by both Django (in production) and the 'db' service in docker-compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Redis Configuration ---
REDIS_URL_CACHE=redis://redis:6379/1

# JWT Settings
JWT_AUDIENCE=
JWT_ISSUER=

# Site URL
SITE_URL=http://localhost:8000

# Email Settings (Example for SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Admin Notification Settings
# ADMIN_TO_NOTIFY_NAME="Admin"
# ADMIN_TO_NOTIFY_EMAIL_ADDRESS="admin@example.com"

# SSL Settings (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# FastAPI Service (optional — email/AI service)
FASTAPI_URL=http://localhost:8080
SYSTEM_CRON_API_KEY=your-system-cron-api-key

# Zernio (social messaging, inbox, publishing, analytics)
ZERNIO_API_KEY=your-zernio-api-key
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
# Copy the signing secret shown for your webhook endpoint:
# POST {SITE_URL}/api/integrations/zernio/webhook/
ZERNIO_WEBHOOK_SECRET=your-zernio-webhook-secret

FRONTEND_URL=http://localhost:3000


# MCP Server
MCP_SERVER_URL=127.0.0.1:10000

# Clerk Authentication (for external APIs/MCPs/AI agents — optional)
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_AUTO_CREATE_USERS=False

# Inngest (background jobs)
# Sign up at https://inngest.com and create a new app
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-your-inngest-signing-key

