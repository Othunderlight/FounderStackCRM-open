# Django Backend URL
DJANGO_BASE_URL=http://127.0.0.1:8000

# Frontend URL (React app — used for OAuth2 login redirect)
FRONTEND_URL=http://localhost:3000

# MCP Server public base URL (used in OAuth metadata)
MCP_PUBLIC_BASE_URL=http://127.0.0.1:10000

# Server port
PORT=10000

# JWT Validation (must match Django backend settings)
JWT_AUDIENCE=
JWT_ISSUER=

# JWKS cache TTL in seconds (default: 1 hour)
JWKS_CACHE_TTL=3600

# Optional: Tavily API key for web search tool
# TAVILY_API_KEY=your-tavily-api-key
